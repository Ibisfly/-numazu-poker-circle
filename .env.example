VITE_FIREBASE_API_KEY=
# アプリを配信するドメインと同じにすること（例: black-swan-circles.web.app）。
# 既定の *.firebaseapp.com のままだとアプリとは別サイト扱いになり、
# Safari / iOS のトラッキング防止で Google ログインが通らなくなる。
# 変更時は Google Cloud Console の OAuth クライアントに
# https://<このドメイン>/__/auth/handler をリダイレクトURIとして登録しておく。
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
