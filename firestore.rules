rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ヘルパー関数 ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSelf(uid)
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending';
      allow update: if (isSelf(uid) && isActiveUser()
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status)
        || isAdmin();
    }

    // ── events ───────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ── attendances ──────────────────────────────────────────────────────────
    match /attendances/{attendanceId} {
      allow read: if isAdmin() || (isActiveUser() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── pointLogs ────────────────────────────────────────────────────────────
    match /pointLogs/{logId} {
      allow read: if isActiveUser() && resource.data.uid == request.auth.uid
        || isAdmin();
      // 自分のログ作成、または管理者が他ユーザー分のログを作成
      allow create: if isAdmin()
        || (isActiveUser() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── tournaments ──────────────────────────────────────────────────────────
    match /tournaments/{tournamentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ── matches ──────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isActiveUser();
      // 一般: participants / rebuys / reentries のみ更新可
      // 管理者: 全フィールド更新可（ステータス変更・精算等）
      allow update: if isAdmin()
        || (isActiveUser() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'rebuys', 'reentries']));
      allow create, delete: if isAdmin();
    }

    // ── matchResults ─────────────────────────────────────────────────────────
    match /matchResults/{resultId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ── matchResultAnnouncements（トーナメントリザルト発表）──────────────────
    match /matchResultAnnouncements/{announcementId} {
      allow read: if (isActiveUser() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isActiveUser() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // ── items ────────────────────────────────────────────────────────────────
    match /items/{itemId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ── userItems ────────────────────────────────────────────────────────────
    match /userItems/{userItemId} {
      allow read: if isActiveUser() && resource.data.uid == request.auth.uid || isAdmin();
      // 管理者は実績報酬としてアイテムを他ユーザーへ付与できる
      allow create: if (isActiveUser() && request.resource.data.uid == request.auth.uid) || isAdmin();
      // 管理者: 全フィールド更新可
      // 本人: usedAt のみ更新可（特典の自己消費）
      allow update: if isAdmin()
        || (isActiveUser()
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt']));
      allow delete: if isAdmin();
    }

    // ── achievements（マスタ） ───────────────────────────────────────────────
    match /achievements/{achievementId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ── userAchievements ─────────────────────────────────────────────────────
    match /userAchievements/{userAchievementId} {
      // 実績はプロフィール閲覧時に表示するため、アクティブユーザーは全員の実績を読める
      allow read: if isActiveUser();
      // 管理者は他ユーザーへの付与も可（精算後の自動解除に必要）
      allow create: if (isActiveUser() && request.resource.data.uid == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── achievementConfigs（管理者が設定する実績報酬）──────────────────────
    match /achievementConfigs/{achievementId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ── userTitles（実績報酬の称号）─────────────────────────────────────────
    match /userTitles/{titleId} {
      allow read: if isActiveUser() && resource.data.uid == request.auth.uid || isAdmin();
      allow create: if (isActiveUser() && request.resource.data.uid == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── yearlyRankings ───────────────────────────────────────────────────────
    match /yearlyRankings/{year} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ── notifications ────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if (isActiveUser() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isActiveUser() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      // create: 管理者またはアクティブユーザーが自分宛に作成可
      allow create: if isAdmin() || isActiveUser();
      allow delete: if isAdmin();
    }

    // ── settings（アプリ設定）───────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ── bingoCards（ビンゴカードマスタ）─────────────────────────────────────
    match /bingoCards/{cardId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ── userBingoCards（ユーザーのビンゴカード進行状況）────────────────────────
    match /userBingoCards/{userCardId} {
      allow read: if isActiveUser() && resource.data.uid == request.auth.uid || isAdmin();
      allow create: if (isActiveUser() && request.resource.data.uid == request.auth.uid) || isAdmin();
      // 本人はセルフスタンプ用、管理者は全更新可
      allow update: if isAdmin() || (isActiveUser() && resource.data.uid == request.auth.uid);
      allow delete: if isActiveUser() && resource.data.uid == request.auth.uid || isAdmin();
    }

    // ── timerSessions（タイマーアプリ）───────────────────────────────────────
    match /timerSessions/{sessionId} {
      // 認証済みユーザーは読み取り可（ライブビュー用）
      allow read: if isSignedIn();
      // 管理者のみ作成・更新・削除
      allow create, update, delete: if isAdmin();

      // プレイヤーサブコレクション
      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }

      // テーブルサブコレクション
      match /tables/{tableId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    // ── bingoMissionTemplates（ビンゴミッションのテンプレートプール）─────────
    match /bingoMissionTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── adminTitles（管理者が作成する非売品称号）─────────────────────────────
    match /adminTitles/{titleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── eventParticipantSummaries（イベント参加者サマリー）───────────────────
    match /eventParticipantSummaries/{summaryId} {
      allow read: if (isActiveUser() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isActiveUser() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // ── playerNotes（個人用プレイヤーメモ）─────────────────────────────────────
    match /playerNotes/{noteId} {
      // 自分が書いたメモのみ読み書き可能（他人には見えない）
      allow read: if isActiveUser() && resource.data.ownerUid == request.auth.uid;
      allow create: if isActiveUser() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActiveUser() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isActiveUser() && resource.data.ownerUid == request.auth.uid;
    }

    // ── handHistories（ハンド履歴）──────────────────────────────────────────────
    match /handHistories/{handId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // ── clockPings（端末時計のズレ計測）────────────────────────────────────────
    // 自分の1ドキュメントに serverTimestamp を書いて読み返すだけの用途
    match /clockPings/{uid} {
      allow read, write: if isSignedIn() && isSelf(uid);
    }

    // ── ライブタイマー / トーナメント表（ログイン不要の公開アプリ）───────────────
    //
    // 会員アカウントを持たない外部ディーラーにも使わせるため、会員ロールで守らない。
    //   閲覧: 誰でも可（リンクを踏んだ全員が進行状況を見られるという要件）
    //   操作: 「操作キー」を知っている端末が admins/{uid} を作れた場合のみ
    //
    // キー本体は読み取り禁止の secret/control に置き、照合はルール内の get() で行う。
    // ルール内の get() はセキュリティルールを迂回して読めるため、キーはクライアントに漏れない。

    function knowsTimerKey(sessionId) {
      return request.resource.data.controlKey ==
        get(/databases/$(database)/documents/liveTimers/$(sessionId)/secret/control).data.key;
    }
    function controlsTimer(sessionId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/liveTimers/$(sessionId)/admins/$(request.auth.uid));
    }
    function knowsBracketKey(bracketId) {
      return request.resource.data.controlKey ==
        get(/databases/$(database)/documents/liveBrackets/$(bracketId)/secret/control).data.key;
    }
    function controlsBracket(bracketId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/liveBrackets/$(bracketId)/admins/$(request.auth.uid));
    }

    match /liveTimers/{sessionId} {
      allow read: if true;
      // 荒らし対策として最低限のサイズ制限をかける
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.levels.size() > 0
        && request.resource.data.levels.size() <= 80;
      // 所有者の書き換えは禁止（操作権の付与元がすり替わらないようにする）
      allow update: if controlsTimer(sessionId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.levels.size() <= 80;
      allow delete: if controlsTimer(sessionId);

      match /secret/{docId} {
        // クライアントからは一切読めない。作成後の変更も不可
        allow read: if false;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      match /admins/{uid} {
        allow read: if isSignedIn() && isSelf(uid);
        // 同じ端末が再訪したときは上書きになるため update も許可する（キー照合は毎回行う）
        allow create, update: if isSignedIn() && isSelf(uid) && knowsTimerKey(sessionId);
        allow delete: if isSignedIn() && isSelf(uid);
      }
    }

    match /liveBrackets/{bracketId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.entrants.size() >= 2
        && request.resource.data.entrants.size() <= 64;
      allow update: if controlsBracket(bracketId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.entrants.size() <= 64;
      allow delete: if controlsBracket(bracketId);

      match /secret/{docId} {
        allow read: if false;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      match /admins/{uid} {
        allow read: if isSignedIn() && isSelf(uid);
        allow create, update: if isSignedIn() && isSelf(uid) && knowsBracketKey(bracketId);
        allow delete: if isSignedIn() && isSelf(uid);
      }
    }
  }
}
